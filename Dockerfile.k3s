FROM python:3.12-slim

# Install system dependencies including Caddy
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential supervisor curl && \
    curl -sL "https://caddyserver.com/api/download?os=linux&arch=amd64" -o /usr/local/bin/caddy && \
    chmod +x /usr/local/bin/caddy && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid 1000 --create-home appuser

WORKDIR /app

# Copy requirements first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and install the package
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir .

# Copy MCP server and supervisor config
COPY mcp_servers/ mcp_servers/
COPY supervisord.k3s.conf /etc/supervisor/conf.d/supervisord.conf

# Create directories for mounted configs and data
RUN mkdir -p /data /data/snapshots /data/attachments /etc/caddy /etc/tls && \
    chown -R appuser:appuser /data

# Mark as containerized
RUN touch /etc/jira-emulator-container

# Environment variables for k8s deployment
ENV DATABASE_URL=sqlite+aiosqlite:////data/jira.db \
    PORT=8080 \
    MCP_PORT=8081 \
    JIRA_USER=admin \
    JIRA_TOKEN=jira-emulator-default-token \
    JIRA_EMULATOR_HOSTNAME=jira-emulator.ai-pipeline.svc.cluster.local \
    TLS_CERT_FILE=/etc/tls/tls.crt \
    TLS_KEY_FILE=/etc/tls/tls.key \
    SEED_DATA=true \
    IMPORT_ON_STARTUP=false \
    ATTACHMENT_DIR=/data/attachments

# Expose ports (HTTPS + HTTP + MCP)
EXPOSE 443
EXPOSE 80
EXPOSE 8081

# Health check (internal, bypasses Caddy)
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/rest/api/2/priority')" || exit 1

USER appuser

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
